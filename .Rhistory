require(hash)
two_sum2 <- function(nums_vector, target) {
hash_table <- hash()
for (i in seq_along(nums_vector)) {
complement <- target - nums_vector[i]
if (hash_table[[as.character(complement)]]) {
result <- c(hash_table[[as.character(complement)]], i)
cat("[1]", result[1] + 1, result[2] + 1, "\n")  # Print in the desired format
}
hash_table[[as.character(nums_vector[i])]] <- i
}
}
