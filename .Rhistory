require(hash)
two_sum2 <- function(nums_vector, target) {
hash_table <- hash()  # Create an empty hash table
# Iterate through nums_vector to build the hash table
for (i in seq_along(nums_vector)) {
complement <- target - nums_vector[i]
# Check if the complement exists in the hash table
if (!is.null(hash_table[[as.character(complement)]])) {
result <- c(hash_table[[as.character(complement)]], i)
cat("# [1]", result[1] + 1, result[2] + 1, "\n")  # Print in the desired format
}
# Add current element and its index to the hash table
if (is.null(hash_table[[as.character(nums_vector[i])]])) {
hash_table[[as.character(nums_vector[i])]] <- i
}
}
}
