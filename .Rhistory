library(stringr)
reorder_name <- function(last_first) {
last_first <- str_trim(last_first)
name_parts <- str_split(last_first, ", ")[[1]]
first_last <- paste(name_parts[2], name_parts[1], sep = " ")
return(first_last)
}
# Inputting Name
name_in <- "Sheets, Dave"
reorder_name(name_in)
name_in <- "Hegge, Nick"
reorder_name(name_in)
powers_df <- function(x) {
df <- data.frame(x = x, x_squared = x^2, sqrt_x = sqrt(x))
return(df)
}
# Test Data
x <- c(1, 3, 5, 7, 9, 11, 13)
powers_df(x)
x <- c(15, 17, 19, 21, 23, 25, 27)
powers_df(x)
two_sum <- function(nums, target) {
n <- length(nums)
result <- list()
for (i in seq_along(nums)) {
for (j in seq_along(nums)) {
if (i != j && nums[i] + nums[j] == target) {
pair <- sort(c(i, j))  # Sort indices in ascending order
result <- c(result, list(pair))  # Collect sorted pair in a list
}
}
}
return(result)
}
